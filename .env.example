# =============================================================================
# TEMPLATE - copy to `.env.local` and fill in the real values:
#   cp .env.example .env.local
#
# `.env.local` is git-ignored; this template is safe to commit because it holds
# no real credentials.
# =============================================================================

# Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Dashboard -> Project Settings -> API -> anon (publishable) key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional, server-only. NEVER prefix with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
